# LLM API Keys
# DeepSeek official API (primary fallback)
DEEPSEEK_API_KEY=sk-

# fastCode AI (unified gateway for Claude + others)
CLAUDE_API_KEY=sk-
CLAUDE_BASE_URL=https://timebackward.com/v1

# MiniMax — 同样走 fastCode AI 网关
MINIMAX_API_KEY=sk-
MINIMAX_BASE_URL=https://timebackward.com/v1

MODEL_PATH=

# Active LLM backend: claude / deepseek / minimax
ACTIVE_LLM=deepseek

# DeepSeek model (deepseek-v4-flash / deepseek-v4-pro / deepseek-chat)
# v4-flash = fast+cheap (推荐); v4-pro = flagship quality; chat = legacy V3.2
DEEPSEEK_MODEL=deepseek-v4-flash

# Claude model (optional, default: claude-sonnet-4-20250514)
# CLAUDE_MODEL=claude-sonnet-4-20250514